# Content approval records bind exact JSON bytes to SHA-256 hashes.
# Preserve those bytes across Windows and Unix checkouts.
docs/content/*.json -text whitespace=cr-at-eol
# The complete-package approval also binds the visual review's exact bytes.
docs/content/package-review.html -text
# Homepage approvals also bind their visual review and review notes.
docs/content/homepage*-review.html -text
docs/content/homepage*-review.md -text
# The accepted hero review and generation script are also bound by exact hash.
docs/content/hero-color-refresh-review.html -text
docs/content/hero-color-refresh-review.md -text
scripts/content/prepare-hero-color-refresh.mjs -text
# Historical approval snapshots must retain their exact source bytes too.
docs/content/catalog-revisions/** -text whitespace=cr-at-eol
# Catalog photograph acceptance and retained snapshots bind exact review bytes.
docs/content/catalog-refresh-68/** -text whitespace=cr-at-eol
# Pose approvals bind current reviews and archived package bytes.
docs/content/catalog-pose-variants/** -text whitespace=cr-at-eol
docs/content/*-photography-review.md -text whitespace=cr-at-eol
# Identity approval records also bind the original font/license bytes.
assets/identity/fonts/* -text
# Preserve upstream license formatting verbatim.
assets/identity/fonts/*OFL.txt whitespace=-blank-at-eol
# Approved SVG hashes include their original line endings; do not normalize.
public/identity/*.svg -text whitespace=cr-at-eol
# Retained checkpoint reports and captures bind their exact evidence bytes.
docs/reviews/issue-35/* -text whitespace=cr-at-eol
docs/reviews/issue-40/** -text whitespace=cr-at-eol
# Playwright code frames retain blank source lines after their line-number pipe.
docs/reviews/issue-40/failures/**/error-context.md whitespace=-blank-at-eol,cr-at-eol
# Blank diff context lines contain a required space; preserve the patch hash.
docs/reviews/issue-35/application.patch whitespace=-blank-at-eol,cr-at-eol
